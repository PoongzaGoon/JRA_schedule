{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "isExample": {
      "type": "boolean"
    },
    "referenceDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sourceUrl": {
      "type": "string",
      "maxLength": 2000,
      "format": "uri"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "stallions": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "object",
            "properties": {
              "ja": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ko": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "koKind": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "official",
                      "ai",
                      "unverified"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "ja",
              "ko",
              "koKind"
            ],
            "additionalProperties": false
          },
          "sourceUrl": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "raceDays": {
            "maxItems": 60,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "entries": {
                  "maxItems": 200,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "raceNumber": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 12
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "venue": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "ja": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 160
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "ko": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 160
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "koKind": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "enum": [
                                      "official",
                                      "ai",
                                      "unverified"
                                    ]
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              }
                            },
                            "required": [
                              "ja",
                              "ko",
                              "koKind"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "raceName": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "ja": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 160
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "ko": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 160
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "koKind": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "enum": [
                                      "official",
                                      "ai",
                                      "unverified"
                                    ]
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              }
                            },
                            "required": [
                              "ja",
                              "ko",
                              "koKind"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "surface": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "turf",
                              "dirt",
                              "jump"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "distanceM": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 100,
                            "maximum": 10000
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "horse": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "ja": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 160
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "ko": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 160
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "koKind": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "enum": [
                                      "official",
                                      "ai",
                                      "unverified"
                                    ]
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              }
                            },
                            "required": [
                              "ja",
                              "ko",
                              "koKind"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "sex": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "male",
                              "female",
                              "gelding"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "age": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 30
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "jockey": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "ja": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 160
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "ko": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 160
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "koKind": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "enum": [
                                      "official",
                                      "ai",
                                      "unverified"
                                    ]
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              }
                            },
                            "required": [
                              "ja",
                              "ko",
                              "koKind"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "weightKg": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 20,
                            "maximum": 100,
                            "multipleOf": 0.5
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "review": {
                        "type": "object",
                        "properties": {
                          "required": {
                            "type": "boolean"
                          },
                          "notes": {
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 1000
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "required",
                          "notes"
                        ],
                        "additionalProperties": false
                      },
                      "extras": {
                        "type": "object",
                        "properties": {
                          "popularity": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 30
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "gate": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 8
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "horseNumber": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 30
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "trainer": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "ja": {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 160
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "ko": {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 160
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "koKind": {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "enum": [
                                          "official",
                                          "ai",
                                          "unverified"
                                        ]
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  }
                                },
                                "required": [
                                  "ja",
                                  "ko",
                                  "koKind"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "finishPosition": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 30
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "previousRace": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 160
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "interval": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 160
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "popularity",
                          "gate",
                          "horseNumber",
                          "trainer",
                          "finishPosition",
                          "previousRace",
                          "interval"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "raceNumber",
                      "venue",
                      "raceName",
                      "surface",
                      "distanceM",
                      "horse",
                      "sex",
                      "age",
                      "jockey",
                      "weightKg",
                      "review",
                      "extras"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "date",
                "entries"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "sourceUrl",
          "raceDays"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "isExample",
    "referenceDate",
    "sourceUrl",
    "notes",
    "stallions"
  ],
  "additionalProperties": false
}
