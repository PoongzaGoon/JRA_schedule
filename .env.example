HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/schedule.sqlite
# Generate using npm run admin:password; paste the resulting hash here.
ADMIN_PASSWORD_HASH=
NODE_ENV=development

# Vercel production: set these in Project Settings > Environment Variables.
# Remote storage takes precedence over DATABASE_PATH; Vercel never uses local SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
